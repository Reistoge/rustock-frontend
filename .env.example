# Copy to `.env` for local development.
#
# Angular bakes environment flags in at build time, so this file is only
# documentation: the npm scripts below select the matching build
# configuration (`src/environments/environment.*.ts`).

# Set to `true` to run the UI without the Rust backend. Uses the in-memory
# stub APIs (`src/app/core/api/stubs/`) with seeded stocks, simulations and
# deterministic trajectories.
#   npm run start:stubs   # dev server with stubs (http://localhost:4200/)
#   npm run build:stubs   # production-style build with stubs
USE_STUBS=false
